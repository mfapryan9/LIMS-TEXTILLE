datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  KEPALA_PRODUKSI
  KEPALA_PPIC
  KEPALA_SEKSI_PPIC
  OPERATOR_PPIC
  KEPALA_LAB
  KEPALA_URUSAN_LAB
  OPERATOR_LAB
  KEPALA_MARKETING
}

enum SampleStatus {
  MENUNGGU
  DALAM_PROSES
  MENUNGGU_APPROVAL
  DISETUJUI
  MATCHING_ULANG
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  role      Role
  logs      AuditLog[]
  createdAt DateTime  @default(now())
}

model Sample {
  id              String       @id @default(uuid())
  spkNo           String       @unique
  orderType       String       // Produksi / Marketing
  partai          String
  customerName    String
  motif           String
  colorDirection  String
  colorCode       String
  labProcess      String
  fabricProblem   String
  problemDesc     String?
  machine         String
  receivedAt      DateTime     @default(now())
  dueDate         DateTime
  isUrgent        Boolean      @default(false)
  urgentReason    String?
  status          SampleStatus @default(MENUNGGU)
  reworkCount     Int          @default(0)
  trials          TestTrial[]
  auditLogs       AuditLog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model MasterProcessTime {
  id          String @id @default(uuid())
  labProcess  String
  machine     String
  standardP   Float  // Waktu proses standar p dalam satuan HARI
  
  @@unique([labProcess, machine])
}

model TestTrial {
  id          String    @id @default(uuid())
  sampleId    String
  sample      Sample    @relation(fields: [sampleId], references: [id])
  trialNo     Int
  startTime   DateTime?
  endTime     DateTime?
  result      String?
  notes       String?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  sampleId  String
  sample    Sample   @relation(fields: [sampleId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  reason    String?
  createdAt DateTime @default(now())
}